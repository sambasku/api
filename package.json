{
  "name": "sambasku-api",
  "version": "0.1.0",
  "description": "Backend API Kamus Digital Sambas-Indonesia",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:accounts": "tsx src/scripts/seed-accounts.ts",
    "seed:reference": "tsx src/scripts/seed-reference.ts",
    "seed:achievements": "tsx src/scripts/seed-achievements.ts",
    "scan:achievements": "tsx src/scripts/scan-achievements.ts",
    "seed:places": "tsx src/scripts/seed-places.ts",
    "seed:cuisines": "tsx src/scripts/seed-cuisines.ts",
    "cleanup-tokens": "tsx src/scripts/cleanup-tokens.ts",
    "dataset:export": "tsx src/scripts/dataset/export-published-dataset.ts",
    "test": "vitest run",
    "test:unit": "vitest run --dir '**/__tests__/unit'",
    "test:integration": "vitest run --dir '**/__tests__/integration'",
    "test:e2e": "vitest run --dir '**/__tests__/e2e'",
    "test:watch": "vitest",
    "db:backfill-activity": "tsx src/scripts/backfill-activity-events.ts",
    "db:backfill-consents": "tsx src/scripts/backfill-user-consents.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.18.0",
    "@scalar/hono-api-reference": "^0.12.13",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.0",
    "rate-limiter-flexible": "^11.2.3",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}