NODE_ENV=development
PORT=3000

# Local: file SQLite (tanpa Docker). Staging/prod: libsql://… + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Email HTTP (Resend) - dipakai LEBIH DULU daripada SMTP kalau di-set.
# Jalur utama di Cloudflare Workers (SMTP = TCP, tidak tersedia di Workers).
# MAIL_PROVIDER=resend|smtp. Kosong: Resend jika RESEND_API_KEY, else SMTP/log.
# Tanpa SMTP maupun ini: OTP/reset hanya di-log (mode dev).
# Staging (NODE_ENV=staging): email tidak dikirim via Resend; OTP tetap 1111-1111.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=SambasKu <no-reply@sambasku.com>

CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
# Domain web publik untuk email + deep link. Kosong = pakai APP_URL.
WEB_APP_URL=http://localhost:5173

# Domain cookie refresh_token. KOSONG di lokal (host-only, seperti semula).
# Di production `.sambasku.com` supaya cookie ikut terkirim ke semua tier API
# (api./deno./render.) dan sesi console tidak putus saat failover pindah tier.
REFRESH_COOKIE_DOMAIN=

# Image provider - dipilih lewat sini (default: imagekit, satu-satunya hari ini).
# Provider baru = impl baru + case di image-storage.factory.ts (Section 8).
IMAGE_PROVIDER=imagekit
# Kredensial PER-PROVIDER (bentuknya beda-beda, jadi memang spesifik):
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Gambar publik (kata + avatar) - repo sambasku/images + jsDelivr/wsrv.
# Token: fine-grained PAT, scope HANYA repo sambasku/images, Contents RW.
# Laporan bug / bukti verifikator TETAP pakai IMAGEKIT_* di atas.
PUBLIC_IMAGE_PROVIDER=github
PUBLIC_IMAGE_GITHUB_TOKEN=
PUBLIC_IMAGE_GITHUB_URL=https://github.com/sambasku/images

# Audio pronunciation storage - dipilih lewat sini (default: github).
# Token: fine-grained PAT, scope HANYA repo sambasku/audios,
# permission Contents RW. Workers: wrangler secret put
# PRONUNCIACION_GITHUB_TOKEN.
PRONUNCIACION_PROVIDER=github
PRONUNCIACION_GITHUB_TOKEN=
PRONUNCIACION_GITHUB_URL=https://github.com/sambasku/audios

# Target repo backup encrypted (non-secret). Token trigger = PUBLIC_IMAGE_GITHUB_TOKEN
# (fallback PRONUNCIACION_GITHUB_TOKEN). PAT harus punya Actions write di repo sqlite.
SQLITE_BACKUP_GITHUB_URL=https://github.com/sambasku/sqlite

# KBBI lemma lookup (docs/api/13-api-kbbi-lemma-definition.md).
# Pola sama IMAGE_PROVIDER: pilih vendor, URL/kredensial spesifik per vendor.
KBBI_PROVIDER=raf555
# Kredensial/URL PER-PROVIDER:
RAF555_BASE_URL=https://kbbi.raf555.dev
# Matikan: KBBI_PROVIDER=none  ATAU  RAF555_BASE_URL=
LEMMA_DEFINITION_CACHE_TTL_SECONDS=3600

# Unsplash / Pixabay - latar kartu share (docs/api/22-api-share-backgrounds.md).
# Tanpa key: provider terkait → items [] + degraded. Openverse anonim (selalu on).
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
SHARE_BACKGROUNDS_CACHE_TTL_SECONDS=86400

# Firebase Cloud Messaging (opsional). Tanpa ketiganya push di-skip (no-op).
# FIREBASE_PRIVATE_KEY = PEM service account (newline sebagai \n di .env).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Trafik Web console (GA4 + Search Console), opsional. Satu service account
# untuk keduanya; kosong = status not_configured (lihat
# docs/backlogs/ANALITIK_GOOGLE.md untuk setup izin Viewer/user).
GOOGLE_ANALYTICS_SA_EMAIL=
GOOGLE_ANALYTICS_SA_PRIVATE_KEY=
# Angka property GA4 (bukan G-XXXX), mis. 123456789
GA4_PROPERTY_ID=
# sc-domain:sambasku.com  atau  https://sambasku.com/
SEARCH_CONSOLE_SITE_URL=
GA4_CACHE_TTL_SECONDS=1800
SEARCH_CONSOLE_CACHE_TTL_SECONDS=21600
# Statistik Play Console (export CSV GCS), opsional. Satu service account
# dengan GA4; kosong = status not_configured di /admin/play-analytics/*.
# Bucket dari Play Console > Download reports > Statistics > Cloud Storage URI.
PLAY_STATS_GCS_BUCKET=
# Prefix object di bucket (default kosong = baca semua, filter by nama file)
PLAY_STATS_GCS_PREFIX=
PLAY_CACHE_TTL_SECONDS=21600
# true = data palsu untuk preview UI lokal (diabaikan di production)
WEB_ANALYTICS_FAKE=false

# OAuth client ID (publik, bukan secret). Flutter
# GOOGLE_WEB_CLIENT_ID_STAGING / _PRODUCTION harus SAMA dengan env API
# matching. Kosong = POST /api/v1/auth/google → 503 GOOGLE_AUTH_UNAVAILABLE.
GOOGLE_CLIENT_ID=

# GitHub OAuth App Client ID (publik). Kosong = POST /api/v1/auth/github
# → 503 GITHUB_AUTH_UNAVAILABLE. Access token diverifikasi ke api.github.com.
GITHUB_CLIENT_ID=
# Secret hanya untuk tukar code→token (mobile). Jangan di APK.
GITHUB_CLIENT_SECRET=

# Facebook Login. App ID publik; App Secret jangan di-commit.
# Flutter FACEBOOK_APP_ID_STAGING / _PRODUCTION harus SAMA dengan App ID
# env matching. Kosong = POST /api/v1/auth/facebook → 503
# FACEBOOK_AUTH_UNAVAILABLE.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Gate write: JWT wajib claim `azp` (client_id). Default false = grace
# (token lama tanpa azp masih lolos). PRODUKSI & STAGING sudah true sejak
# issue #31 - lihat wrangler.toml. docs/api/35-api-oauth-client-azp.md.
OAUTH_REQUIRE_AZP=false
